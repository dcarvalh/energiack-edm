# Copy to .env (git-ignored) and fill in. Never commit the real file.

# Database password. Generate one:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Local use: leave these as they are, the app is on http://127.0.0.1:8088/
# On a public server: your domain name (the HTTPS certificate is automatic) and the public ports.
#SITE_ADDRESS=edm.example.ch
#HTTP_BIND=80
#HTTPS_BIND=443

# 1 = load the fictional Rive-Claire dataset at start (default). 0 = start empty.
#SEED_DEMO=1

# 1 = one-click demo accounts (one per role) on the login screen. For a public demo only, never with real data.
#DEMO_LOGIN=0

# Several names for the same server (e.g. a domain and a fallback): SITE_ADDRESS="edm.example.ch, 1-2-3-4.sslip.io"
